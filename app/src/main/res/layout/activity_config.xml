<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.config.ConfigActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajuste o app do seu jeito."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Card Opções -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNotificacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Notificações"
                android:textColor="#FFFFFF" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Compartilhamento de localização"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnSeguranca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:text="Segurança ›"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:text="Tema: Escuro"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnIdioma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:text="Idioma: Português ›"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnSobre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:text="Sobre o aplicativo (v1.0.0) ›"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="Sair da conta"
            android:textColor="#E74C3C"
            android:textStyle="bold" />
    </LinearLayout>

</ScrollView>